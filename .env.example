# ══════════════════════════════════════════════════════════════════════════════
# .env.example — Viet Neu TTS v3 Turbo (INT8, CPU)
# ══════════════════════════════════════════════════════════════════════════════
# Sao chep file nay thanh .env roi chinh sua:
#   cp .env.example .env

# ── Model precision (hardcode, khong doi duong) ────────────────────────────────
# Engine luon dung INT8 — gia tri nay chi de thong khong tac dung.
VIENEU_PRECISION=int8

# ── Token auth ────────────────────────────────────────────────────────────────
# Dat token khi deploy tren server public. De trong = khong auth (localhost dev).
# Vi du: VIENEU_TOKEN=mk-abc123xyz
# VIENEU_TOKEN=

# ── Model local dirs ──────────────────────────────────────────────────────────
# Mac dinh: model/onnx_int8 va model/codec. Bo trong = engine tu tim model/.
# Neu khong co model/, engine download ve model/ tu Hugging Face.
# Vi du tren server: VIENEU_ONNX_DIR=/opt/vieneu/model/onnx_int8
#VIENEU_ONNX_DIR=
#VIENEU_CODEC_DIR=

# ── Server bind ───────────────────────────────────────────────────────────────
# VIENEU_HOST: 127.0.0.0 = chi may local; 0.0.0.0 = cho phep ket noi tu mang/server.
# VIENEU_PORT: cong server (mac dinh 8001).
VIENEU_HOST=127.0.0.1
VIENEU_PORT=8001

# ── Windows Unicode (giu nguyen 2 dong nay) ───────────────────────────────────
# Tranh loi tieng Viet tren Windows console.
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# ══════════════════════════════════════════════════════════════════════════════
# Vi du cho server deploy (co token + public):
# ══════════════════════════════════════════════════════════════════════════════
# VIENEU_PRECISION=int8
# VIENEU_TOKEN=mk-secret-token-here
# VIENEU_ONNX_DIR=/opt/vieneu/model/onnx_int8
# VIENEU_CODEC_DIR=/opt/vieneu/model/codec
# VIENEU_HOST=0.0.0.0
# VIENEU_PORT=8001
# PYTHONUTF8=1
# PYTHONIOENCODING=utf-8

# ══════════════════════════════════════════════════════════════════════════════
# Vi du cho localhost dev (khong token, chi may local):
# ══════════════════════════════════════════════════════════════════════════════
# VIENEU_PRECISION=int8
# VIENEU_HOST=127.0.0.1
# VIENEU_PORT=8001
# PYTHONUTF8=1
# PYTHONIOENCODING=utf-8

