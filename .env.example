# Cau hinh ca nhan cho VieNeu-TTS ban gon nhe (server local 127.0.0.1:8001).
# Danh tu https://github.com/pnnbao97/VieNeu-TTS (Apache-2.0) — xem NOTICE.
# Copy file nay thanh .env roi sua. Bo trong 2 dong VIENEU_*_DIR = dung HF cache.

# Backbone ONNX/CPU: fp32 (chat luong toi da, mac dinh) | int8 (nhe ~3x, nhanh hon)
VIENEU_PRECISION=fp32

# Thu muc model local (mac dinh code tu tim model/onnx_int8 va model/codec).
# Chi can dat khi model de cho khac. Vi du Windows: VIENEU_ONNX_DIR=D:/models/vieneu/onnx_int8
#VIENEU_ONNX_DIR=
#VIENEU_CODEC_DIR=

# Giu nguyen 2 dong duoi de khong loi tieng Viet tren Windows
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
